[Unit]
Description=Sinty locale service (localed-compatible)
Documentation=https://github.com/singularityos-lab/sinty-locale
After=dbus.service

[Service]
Type=dbus
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
BusName=org.freedesktop.locale1
ExecStart=/usr/libexec/sinty-localed
Restart=on-failure
RestartSec=1
